# ==============================================================================
# CONFIGURACION DE BASE DE DATOS LOCAL O EN RED (POSTGRESQL)
# Si instalas PostgreSQL directamente en Windows (o usas un servidor en red):
# ==============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=luis
DB_USER=adempiere
DB_PASSWORD=adempiere
DB_SSL=false

# ==============================================================================
# SEGURIDAD DE SESIONES Y AUTENTICACION
# ==============================================================================

AUTH_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200

